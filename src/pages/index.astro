---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const published = projects.filter((p) => p.data.status !== 'placeholder');

const categories = [
  { slug: 'ai-solutions', label: 'AI Solutions' },
  { slug: 'ml-data-science', label: 'ML / MLOps + Data Science' },
  { slug: 'software-engineering', label: 'Software Engineering' },
];
---

<Layout title="Home">
  <h1>Andrey Popov</h1>
  <p class="hook">
    Finance-born AI Solutions Engineer — twenty years closing IFRS books, then walked into a
    room full of neural networks and didn't blink. Now building agentic AI, RAG, and MLOps
    systems, based in Neuchâtel, Switzerland.
  </p>

  <h2>Explore by category</h2>
  {categories.map((c) => {
    const count = published.filter((p) => p.data.category === c.slug).length;
    return (
      <a class="card" href={`/${c.slug}`}>
        <h3>{c.label} <span class="badge">{count} project{count === 1 ? '' : 's'}</span></h3>
      </a>
    );
  })}

  <h2>Elsewhere</h2>
  <p class="links">
    <a href="https://www.linkedin.com/in/andrey-p-58ab10100">LinkedIn</a>
    <a href="https://github.com/vospr">GitHub</a>
  </p>
</Layout>
