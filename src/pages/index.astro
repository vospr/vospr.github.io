---
import Layout from '../layouts/Layout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getCollection } from 'astro:content';
import { SHOW_CV } from '../config';

const areaLabels: Record<string, string> = {
  'ai-solutions': 'AI Solutions',
  'ml-data-science': 'ML + Data Science',
  'software-engineering': 'Software Engineering',
};

const all = await getCollection('projects');
const live = all.filter((p) => !p.data.draft);
const featured = live.filter((p) => p.data.featured).sort((a, b) => a.data.order - b.data.order);

const areas = [
  { slug: 'ai-solutions', label: 'AI Solutions' },
  { slug: 'ml-data-science', label: 'ML + Data Science' },
  { slug: 'software-engineering', label: 'Software Engineering' },
];
---

<Layout
  title="Home"
  description="AI Solutions Engineer with a background in finance: agentic workflows, MCP, data and ML pipelines. Based in Neuchâtel, Switzerland."
>
  <main class="wrap home">
    <section class="hero">
      <div class="avail meta">
        <span class="on"><span class="dot"></span>EPAM Systems</span>
      </div>
      <h1>AI Solutions Engineer with a background in finance.</h1>
      <p class="lede">
        I used to close financial reporting books. Now I design and build agentic AI workflows and
        data/ML pipelines, and I can explain them to the CFO as well as the CTO.
      </p>
      <div class="btns">
        {SHOW_CV && <a class="btn primary" href="/cv.pdf">Download CV</a>}
        <a class="btn-icon" href="mailto:cv.andrey.popov@gmail.com" aria-label="Email" title="Email">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5v-13Zm1.8.3 8.2 6.15 8.2-6.15H3.8Zm16.7 1.2-8.02 6.02a1 1 0 0 1-1.16 0L3.5 7v11h17V7Z"/>
          </svg>
        </a>
        <a class="btn-icon" href="https://www.linkedin.com/in/andrey-p-58ab10100" aria-label="LinkedIn" title="LinkedIn" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.86 0-2.15 1.45-2.15 2.94v5.66H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.59 0 4.25 2.36 4.25 5.44v6.3ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/>
          </svg>
        </a>
        <a class="btn-icon" href="https://github.com/vospr" aria-label="GitHub" title="GitHub" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1-.02-1.96-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.43-2.69 5.41-5.25 5.69.42.36.78 1.08.78 2.18 0 1.58-.01 2.85-.01 3.24 0 .3.2.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/>
          </svg>
        </a>
      </div>
    </section>

    <section>
      <div class="list-head">
        <h2 class="label">Selected work</h2>
        <span class="meta">{live.length} projects</span>
      </div>
      {featured.map((p) => (
        <ProjectRow project={p} areaLabel={areaLabels[p.data.category]} />
      ))}
    </section>

    <section>
      <h2 class="label">All work by area</h2>
      <div class="areas">
        {areas.map((a) => {
          const count = live.filter((p) => p.data.category === a.slug).length;
          return (
            <a class="area" href={`/${a.slug}`}>
              {a.label} <span class="meta">{count} →</span>
            </a>
          );
        })}
      </div>
    </section>
  </main>
</Layout>
