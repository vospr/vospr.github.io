---
import Layout from '../layouts/Layout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getCollection } from 'astro:content';

const areaLabels: Record<string, string> = {
  'ai-solutions': 'AI Solutions',
  'ml-data-science': 'ML / MLOps',
  'software-engineering': 'Software Engineering',
};

const all = await getCollection('projects');
const published = all.filter((p) => p.data.status !== 'placeholder');
const featured = all
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const areas = [
  { slug: 'ai-solutions', label: 'AI Solutions' },
  { slug: 'ml-data-science', label: 'ML / MLOps + DS' },
  { slug: 'software-engineering', label: 'Software Engineering' },
];
---

<Layout title="Home">
  <main class="wrap home">
    <section class="hero">
      <div class="avail meta">
        <span class="on"><span class="dot"></span>Open to AI engineering roles</span>
        <span>Neuchâtel · Switzerland</span>
      </div>
      <h1>AI Solutions Engineer with twenty years in finance.</h1>
      <p class="lede">
        I closed IFRS books for two decades. Now I build agentic AI, RAG and MLOps systems, and
        I can explain them to the CFO as well as the CTO.
      </p>
      <div class="btns">
        <a class="btn primary" href="/cv.pdf">Download CV</a>
        <a class="btn" href="mailto:cv.andrey.popov@gmail.com">Email</a>
        <a class="btn" href="https://www.linkedin.com/in/andrey-p-58ab10100">LinkedIn</a>
        <a class="btn" href="https://github.com/vospr">GitHub</a>
      </div>
    </section>

    <section>
      <div class="list-head">
        <h2 class="label">Selected work</h2>
        <span class="meta">{published.length} projects</span>
      </div>
      {featured.map((p) => (
        <ProjectRow project={p} areaLabel={areaLabels[p.data.category]} />
      ))}
    </section>

    <section>
      <h2 class="label">All work by area</h2>
      <div class="areas">
        {areas.map((a) => {
          const count = published.filter((p) => p.data.category === a.slug).length;
          return (
            <a class="area" href={`/${a.slug}`}>
              {a.label} <span class="meta">{count} →</span>
            </a>
          );
        })}
      </div>
    </section>
  </main>
</Layout>
