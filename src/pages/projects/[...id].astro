---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const areaLabels: Record<string, string> = {
  'ai-solutions': 'AI Solutions',
  'ml-data-science': 'ML + Data Science',
  'software-engineering': 'Software Engineering',
};
const areaSlugs: Record<string, string> = {
  'ai-solutions': '/ai-solutions',
  'ml-data-science': '/ml-data-science',
  'software-engineering': '/software-engineering',
};

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.draft);
  return projects.map((p) => ({
    params: { id: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const d = project.data;
---

<Layout title={d.title} description={d.hook}>
  <article class="wrap project">
    <div class="intro">
      <div class="meta">
        <a href={areaSlugs[d.category]}>{areaLabels[d.category]}</a> / {d.title.split(' / ')[0]}
      </div>
      <h1>{d.title}</h1>
      <p class="hook">{d.hook}</p>
    </div>

    {d.facts.length > 0 && (
      <div class="facts">
        {d.facts.map((f: { k: string; v: string }) => (
          <div>
            <span class="k">{f.k}</span>
            <span class="v">{f.v}</span>
          </div>
        ))}
      </div>
    )}

    {d.caseStudy && (
      <section class="case-evidence" aria-labelledby="evidence-heading">
        <h2 id="evidence-heading" class="label">Evidence status / {d.caseStudy.asOf}</h2>
        <dl class="evidence-grid">
          {d.caseStudy.evidence.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.detail}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <div class="body">
      <div class="main">
        <section>
          <h2 class="label">Problem</h2>
          <p>{d.problem}</p>
        </section>
        <section>
          <h2 class="label">What it does</h2>
          <p>{d.whatItDoes}</p>
        </section>
        {d.howItsBuilt.length > 0 && (
          <section>
            <h2 class="label">How it's built</h2>
            <ul>
              {d.howItsBuilt.map((b: { lead: string; detail: string }) => (
                <li><strong>{b.lead}:</strong> {b.detail}</li>
              ))}
            </ul>
          </section>
        )}
        {d.caseStudy && (
          <>
            <section aria-labelledby="workflow-heading">
              <h2 id="workflow-heading" class="label">From evidence to answer</h2>
              <figure class="workflow">
                <ol>
                  {d.caseStudy.workflow.map((step) => (
                    <li><strong>{step.label}</strong><span>{step.detail}</span></li>
                  ))}
                </ol>
                <figcaption>{d.caseStudy.workflowNote}</figcaption>
              </figure>
            </section>
            <section aria-labelledby="examples-heading">
              <h2 id="examples-heading" class="label">Three recorded local examples</h2>
              <div class="case-examples">
                {d.caseStudy.examples.map((example) => (
                  <div><h3>{example.label}</h3><p>{example.detail}</p></div>
                ))}
              </div>
              <p class="case-note">{d.caseStudy.exampleNote}</p>
            </section>
            <section aria-labelledby="excerpt-heading">
              <h2 id="excerpt-heading" class="label">Check one answer</h2>
              <p><strong>Question:</strong> {d.caseStudy.excerpt.question}</p>
              <blockquote class="answer-excerpt">{d.caseStudy.excerpt.answer}</blockquote>
              <p>{d.caseStudy.excerpt.check}</p>
              <p class="case-note">{d.caseStudy.excerpt.qualification}</p>
            </section>
          </>
        )}
      </div>
      {(d.links.length > 0 || d.stackGroups.length > 0) && (
        <aside class="aside">
          {d.links.length > 0 && (
            <div class="grp">
              <span class="k">Links</span>
              {d.links.map((l: { label: string; url: string }) => (
                <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>
              ))}
            </div>
          )}
          {d.stackGroups.map((g: { label: string; items: string[] }) => (
            <div class="grp">
              <span class="k">{g.label}</span>
              <span class="items">{g.items.join(' · ')}</span>
            </div>
          ))}
        </aside>
      )}
    </div>
  </article>
</Layout>

<style>
  .case-evidence { padding: 22px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .evidence-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 20px; margin: 18px 0 0; }
  .evidence-grid dt { font-weight: 600; margin-bottom: 6px; }
  .evidence-grid dd { margin: 0; font-size: 14px; color: var(--hook-color); }
  .workflow { margin: 0; }
  .workflow ol { list-style: decimal; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding-left: 22px; }
  .workflow li { padding: 12px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .workflow strong, .workflow span { display: block; }
  .workflow span { margin-top: 6px; font-size: 14px; }
  .workflow figcaption, .case-note { font-size: 14px; color: var(--muted); margin-top: 16px; }
  .case-examples { display: flex; flex-direction: column; gap: 18px; }
  .case-examples h3 { font-size: 16px; margin: 0 0 6px; }
  .answer-excerpt { margin: 16px 0; padding: 14px 18px; border-left: 3px solid var(--accent); background: var(--surface); overflow-wrap: anywhere; }
  @media (max-width: 520px) { .workflow ol { grid-template-columns: 1fr; } }
</style>
