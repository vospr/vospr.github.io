---
import Layout from '../layouts/Layout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const labels: Record<string, string> = {
    'ai-solutions': 'AI Solutions',
    'ml-data-science': 'ML / MLOps + Data Science',
    'software-engineering': 'Software Engineering',
  };
  return Object.entries(labels).map(([category, label]) => ({
    params: { category },
    props: { label },
  }));
}

const { category } = Astro.params;
const { label } = Astro.props;

const projects = (await getCollection('projects'))
  .filter((p) => p.data.category === category)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title={label}>
  <main class="wrap home">
    <section class="hero">
      <h1>{label}</h1>
    </section>
    <section>
      {projects.map((p) => (
        <ProjectRow project={p} areaLabel={label} />
      ))}
    </section>
  </main>
</Layout>
