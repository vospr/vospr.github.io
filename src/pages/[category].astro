---
import Layout from '../layouts/Layout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const meta: Record<string, { label: string; description: string }> = {
    'ai-solutions': {
      label: 'AI Solutions',
      description: 'Agentic AI workflows, MCP and multi-agent systems — from a governed AI workflow prototype and an MCP decision memo to AI-delivery cost measurement and Claude Code workflow tooling.',
    },
    'ml-data-science': {
      label: 'ML + Data Science',
      description: 'End-to-end ML pipelines, data platforms and forecasting — from a production candidate-matching pipeline to econometric forecasting research.',
    },
    'software-engineering': {
      label: 'Software Engineering',
      description: 'Team delivery work: release hardening and a human-coaching integration on an AI coaching platform rebuild.',
    },
  };
  return Object.entries(meta).map(([category, m]) => ({
    params: { category },
    props: m,
  }));
}

const { category } = Astro.params;
const { label, description } = Astro.props;

const projects = (await getCollection('projects'))
  .filter((p) => p.data.category === category && !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title={label} description={description}>
  <main class="wrap home">
    <section class="hero">
      <h1>{label}</h1>
      <p class="lede">{description}</p>
    </section>
    <section>
      {projects.map((p) => (
        <ProjectRow project={p} showArea={false} />
      ))}
    </section>
  </main>
</Layout>
