---
const { project, areaLabel, showArea = true } = Astro.props;
const tags = project.data.keyTags?.length
  ? project.data.keyTags
  : project.data.stackGroups.flatMap((g: { items: string[] }) => g.items).slice(0, 4);
---
<a class="row" href={`/projects/${project.id}`}>
  <div>
    <span class="t">{project.data.title}</span>
    {showArea && <span class="meta">{areaLabel}</span>}
  </div>
  <div>
    <span class="sum">{project.data.summary}</span>
    <span class="meta">{tags.join(' · ')}</span>
  </div>
</a>
