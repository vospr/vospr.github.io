---
// Update after the Worker is deployed: wrangler gives you the *.workers.dev URL.
const WORKER_URL = 'https://andrey-portfolio-chat.vospr2.workers.dev/chat';
---

<div id="chat-root">
  <button id="chat-launcher" class="cw-launcher" aria-label="Ask about my work">
    <span class="cw-launcher-icon">
      <picture>
        <source media="(max-width: 480px)" srcset="/chat-verdict-dial-mobile.svg" />
        <img src="/chat-verdict-dial.svg" width="64" height="64" alt="" aria-hidden="true" />
      </picture>
      <span class="cw-launcher-dot"></span>
    </span>
    Ask about my work
  </button>

  <div id="chat-panel" class="cw-panel" hidden>
    <div class="cw-header">
      <div>
        <div class="cw-title">Ask about my work</div>
        <div class="cw-subtitle">Projects · stack · experience</div>
      </div>
      <button id="chat-close" class="cw-close" aria-label="Close">−</button>
    </div>
    <div id="chat-log" class="cw-log">
      <div id="chat-empty" class="cw-empty">
        <p>Hi, I can answer questions about Andrey's projects, stack and background.</p>
        <p>Answers are AI-generated. Check the project pages for detail.</p>
      </div>
    </div>
    <form id="chat-form" class="cw-form">
      <textarea
        id="chat-input"
        class="cw-input"
        placeholder="e.g. how does Verdaca's agent routing work?"
        autocomplete="off"
        rows="1"
      ></textarea>
      <button type="submit" id="chat-send" class="cw-send" aria-label="Send message" disabled>
        <picture>
          <source media="(max-width: 480px)" srcset="/chat-send-mobile.svg" />
          <img src="/chat-send.svg" width="32" height="32" alt="" aria-hidden="true" />
        </picture>
      </button>
    </form>
  </div>
</div>

<script define:vars={{ WORKER_URL }}>
  const root = document.getElementById('chat-root');
  const launcher = document.getElementById('chat-launcher');
  const panel = document.getElementById('chat-panel');
  const closeBtn = document.getElementById('chat-close');
  const log = document.getElementById('chat-log');
  let emptyState = document.getElementById('chat-empty');
  const form = document.getElementById('chat-form');
  const input = document.getElementById('chat-input');
  const sendBtn = document.getElementById('chat-send');

  let history = [];
  let lastUserMessage = null;

  function open() {
    panel.hidden = false;
    launcher.hidden = true;
    input.focus();
  }
  function resetConversation() {
    history = [];
    lastUserMessage = null;
    input.value = '';
    sendBtn.disabled = true;
    log.innerHTML = '';
    const el = document.createElement('div');
    el.id = 'chat-empty';
    el.className = 'cw-empty';
    el.innerHTML =
      "<p>Hi, I can answer questions about Andrey's projects, stack and background.</p>" +
      '<p>Answers are AI-generated. Check the project pages for detail.</p>';
    log.appendChild(el);
    emptyState = el;
  }

  function close() {
    panel.hidden = true;
    launcher.hidden = false;
    resetConversation();
  }
  launcher.addEventListener('click', open);
  closeBtn.addEventListener('click', close);

  input.addEventListener('input', () => {
    sendBtn.disabled = !input.value.trim();
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      if (!sendBtn.disabled) form.requestSubmit();
    }
  });

  function hideEmptyState() {
    if (emptyState) emptyState.remove();
  }

  function addUser(text) {
    hideEmptyState();
    const el = document.createElement('div');
    el.className = 'cw-msg-user';
    el.textContent = text;
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
  }

  // Minimal, safe markdown renderer for assistant replies. Everything is
  // HTML-escaped first; only the specific patterns below are turned into
  // tags. Nothing else passes through, since this text comes from an LLM
  // and must be treated as untrusted input.
  function escapeHtml(s) {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function renderInline(s) {
    s = s.replace(/`([^`]+)`/g, '<code>$1</code>');
    s = s.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
    s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    s = s.replace(/(^|[^*])\*([^*\n]+)\*(?!\*)/g, '$1<em>$2</em>');
    s = s.replace(/(^|[^_])_([^_\n]+)_(?!_)/g, '$1<em>$2</em>');
    return s;
  }

  function renderMarkdown(raw) {
    const lines = escapeHtml(raw).split('\n');
    let html = '';
    let i = 0;
    while (i < lines.length) {
      const line = lines[i];
      if (!line.trim()) { i++; continue; }

      const heading = line.match(/^#{1,3}\s+(.*)/);
      if (heading) {
        html += `<p class="cw-h">${renderInline(heading[1])}</p>`;
        i++;
        continue;
      }

      if (/^[-*]\s+/.test(line)) {
        const items = [];
        while (i < lines.length && /^[-*]\s+/.test(lines[i])) {
          items.push(`<li>${renderInline(lines[i].replace(/^[-*]\s+/, ''))}</li>`);
          i++;
        }
        html += `<ul>${items.join('')}</ul>`;
        continue;
      }

      if (/^\d+\.\s+/.test(line)) {
        const items = [];
        while (i < lines.length && /^\d+\.\s+/.test(lines[i])) {
          items.push(`<li>${renderInline(lines[i].replace(/^\d+\.\s+/, ''))}</li>`);
          i++;
        }
        html += `<ol>${items.join('')}</ol>`;
        continue;
      }

      const para = [line];
      i++;
      while (i < lines.length && lines[i].trim() && !/^[-*]\s+/.test(lines[i]) && !/^\d+\.\s+/.test(lines[i]) && !/^#{1,3}\s+/.test(lines[i])) {
        para.push(lines[i]);
        i++;
      }
      html += `<p>${renderInline(para.join(' '))}</p>`;
    }
    return html;
  }

  function addAssistant(text) {
    const el = document.createElement('div');
    el.className = 'cw-msg-assistant';
    el.innerHTML = renderMarkdown(text);
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
    return el;
  }

  function addTyping() {
    const el = document.createElement('div');
    el.className = 'cw-msg-assistant';
    el.innerHTML = '<div class="cw-typing"><span></span><span></span><span></span></div>';
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
    return el;
  }

  function addError() {
    const el = document.createElement('div');
    el.className = 'cw-error';
    el.innerHTML = "Couldn't get an answer right now. <button type=\"button\">Try again →</button>";
    el.querySelector('button').addEventListener('click', () => {
      el.remove();
      if (lastUserMessage) sendMessage(lastUserMessage, { skipEcho: true });
    });
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
    return el;
  }

  async function sendMessage(text, { skipEcho = false } = {}) {
    lastUserMessage = text;
    if (!skipEcho) addUser(text);
    const typingEl = addTyping();

    try {
      const res = await fetch(WORKER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text, history }),
      });
      if (!res.ok) throw new Error('Bad response');
      const data = await res.json();
      typingEl.remove();
      addAssistant(data.text || 'No response.');
      history.push({ role: 'user', text });
      history.push({ role: 'bot', text: data.text || '' });
      lastUserMessage = null;
    } catch (err) {
      typingEl.remove();
      addError();
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    sendBtn.disabled = true;
    sendMessage(text);
  });
</script>

<style is:global>
  /* Global (not scoped): most message elements are created client-side via
     createElement, so they never receive Astro's data-astro-cid scoping
     attribute — scoped selectors would silently fail to match them. */
  #chat-root {
    font-family: var(--font-body);
  }

  .cw-launcher {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 10px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 16px 6px 6px;
    font: 600 17px var(--font-body);
    cursor: pointer;
    transition: color 120ms ease;
  }
  .cw-launcher:hover { color: var(--accent); }
  .cw-launcher-icon {
    position: relative;
    display: inline-flex;
    flex: none;
  }
  .cw-launcher-icon img {
    display: block;
  }
  .cw-launcher-dot {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 2px solid #000000;
  }

  .cw-panel {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 51;
    width: 380px;
    height: min(600px, calc(100vh - 40px));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 12px 32px rgba(21, 23, 26, 0.12);
    font-family: var(--font-body);
  }
  .cw-panel[hidden] { display: none; }

  .cw-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--border);
  }
  .cw-title { font: 600 17px var(--font-heading); }
  .cw-subtitle { font: 11px var(--font-mono); color: var(--muted); margin-top: 2px; }
  .cw-close {
    width: 32px;
    height: 32px;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 50%;
    color: var(--muted);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .cw-close:hover { border-color: var(--accent); color: var(--fg); }

  .cw-log {
    flex: 1;
    overflow-y: auto;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .cw-empty {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cw-empty p:first-child { margin: 0; font: 18px/1.45 var(--font-heading); color: var(--fg); }
  .cw-empty p:last-child { margin: 0; font-size: 13px; color: var(--muted); }

  .cw-msg-user {
    align-self: flex-end;
    max-width: 85%;
    background: color-mix(in srgb, var(--accent) 9%, var(--surface));
    color: var(--fg);
    border-radius: 6px;
    padding: 9px 12px;
    font-size: 14px;
    line-height: 1.5;
  }

  .cw-msg-assistant {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg);
  }
  .cw-msg-assistant::before {
    content: 'Assistant';
    font: 11px var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: normal;
  }
  .cw-msg-assistant p { margin: 0 0 10px; }
  .cw-msg-assistant p:last-child { margin-bottom: 0; }
  .cw-msg-assistant p.cw-h {
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.01em;
    margin: 4px 0 2px;
  }
  .cw-msg-assistant ul, .cw-msg-assistant ol { margin: 0 0 10px; padding-left: 18px; }
  .cw-msg-assistant li { margin: 2px 0; }
  .cw-msg-assistant strong { font-weight: 600; }
  .cw-msg-assistant em { font-style: italic; }
  .cw-msg-assistant a { color: var(--accent); }
  .cw-msg-assistant code {
    font: 12.5px var(--font-mono);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 5px;
  }

  .cw-typing { display: flex; gap: 5px; align-items: center; height: 22px; }
  .cw-typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted);
    animation: cw-dot 1.2s infinite ease-in-out;
  }
  .cw-typing span:nth-child(2) { animation-delay: 0.15s; }
  .cw-typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes cw-dot {
    0%, 80%, 100% { opacity: 0.25; transform: translateY(0); }
    40% { opacity: 1; transform: translateY(-2px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cw-typing span { animation: none; opacity: 0.6; }
  }

  .cw-error {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    border: 1px solid #f0d4d1;
    background: #fdf6f5;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 14px;
    color: var(--fg);
  }
  .cw-error::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #b3261e;
    margin-top: 8px;
    flex: none;
  }
  .cw-error button, .cw-error a {
    font: 12px var(--font-mono);
    color: var(--accent);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .cw-form {
    display: flex;
    gap: 8px;
    align-items: flex-end;
    padding: 12px;
    border-top: 1px solid var(--border);
  }
  .cw-input {
    flex: 1;
    min-height: 44px;
    max-height: 120px;
    resize: none;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 11px 12px;
    font: 14px/1.4 var(--font-body);
    color: var(--fg);
    background: var(--bg);
  }
  .cw-input::placeholder { color: #8a8d92; }
  .cw-input:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--surface);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .cw-send {
    height: 44px;
    width: 44px;
    flex: none;
    padding: 6px;
    border: none;
    border-radius: 8px;
    background: #1F2226;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px #0003;
    transition: background 120ms ease, transform 120ms ease, box-shadow 120ms ease, opacity 120ms ease;
  }
  .cw-send img {
    display: block;
    transform: rotate(-90deg);
  }
  .cw-send:hover:not(:disabled) {
    background: #34383d;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px #0005;
  }
  .cw-send:active:not(:disabled) { transform: translateY(0); }
  .cw-send:disabled {
    opacity: 0.35;
    cursor: default;
    box-shadow: none;
    transform: none;
  }

  @media (max-width: 480px) {
    .cw-launcher-dot { background: #000000; border-color: #FFFFFF; }
    .cw-panel {
      inset: 0;
      width: 100%;
      height: 100dvh;
      border-radius: 0;
      border: none;
    }
    .cw-close { width: 44px; height: 44px; font-size: 18px; }
    .cw-msg-user, .cw-msg-assistant { font-size: 15px; }
    .cw-input { font-size: 16px; min-height: 48px; }
    .cw-send {
      height: 48px;
      width: 48px;
      padding: 7px;
      border: 1px solid #1F2226;
      background: #FFFFFF;
    }
    .cw-send:hover:not(:disabled) { background: #f2f2f2; }
    .cw-send:disabled { opacity: 1; }
    .cw-form { padding: 10px 12px calc(16px + env(safe-area-inset-bottom)); }
  }

  @media (prefers-color-scheme: dark) {
    .cw-error { background: #2a1716; border-color: #5a2a26; }
    .cw-error::before { background: #ff8a80; }
  }
</style>
