---
// Update after the Worker is deployed: wrangler gives you the *.workers.dev URL.
const WORKER_URL = 'https://andrey-portfolio-chat.vospr2.workers.dev/chat';
---

<div id="chat-root">
  <button id="chat-launcher" aria-label="Ask about these projects">
    <span class="chat-dot"></span>
    <span class="chat-launcher-label">Ask about the code</span>
  </button>

  <div id="chat-panel" hidden>
    <div class="chat-head">
      <span class="chat-head-title">Ask about these projects</span>
      <span class="chat-head-sub">Scoped to Andrey's public repos only</span>
      <button id="chat-close" aria-label="Close">×</button>
    </div>
    <div id="chat-log"></div>
    <form id="chat-form">
      <input id="chat-input" type="text" placeholder="e.g. how does Verdaca's agent routing work?" autocomplete="off" />
      <button type="submit">Send</button>
    </form>
  </div>
</div>

<script define:vars={{ WORKER_URL }}>
  const root = document.getElementById('chat-root');
  const launcher = document.getElementById('chat-launcher');
  const panel = document.getElementById('chat-panel');
  const closeBtn = document.getElementById('chat-close');
  const log = document.getElementById('chat-log');
  const form = document.getElementById('chat-form');
  const input = document.getElementById('chat-input');

  let history = [];
  let opened = false;

  function open() {
    panel.hidden = false;
    root.classList.add('open');
    if (!opened) {
      opened = true;
      addBot(
        "Hi — I can answer questions about how Andrey's public projects work: architecture, why something was built a certain way, what a specific file does. Scoped only to the repos linked on this site."
      );
    }
    input.focus();
  }
  function close() {
    panel.hidden = true;
    root.classList.remove('open');
  }
  launcher.addEventListener('click', open);
  closeBtn.addEventListener('click', close);

  function addUser(text) {
    const el = document.createElement('div');
    el.className = 'msg user';
    el.textContent = text;
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
  }

  function addBot(text) {
    const el = document.createElement('div');
    el.className = 'msg bot';
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
    typeReveal(el, text);
    return el;
  }

  function typeReveal(el, text) {
    let i = 0;
    const step = Math.max(1, Math.floor(text.length / 120));
    const timer = setInterval(() => {
      i += step;
      el.textContent = text.slice(0, i);
      log.scrollTop = log.scrollHeight;
      if (i >= text.length) {
        el.textContent = text;
        clearInterval(timer);
      }
    }, 12);
  }

  function addThinking() {
    const el = document.createElement('div');
    el.className = 'msg bot thinking';
    el.innerHTML = '<span class="cursor">▍</span>';
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
    return el;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    addUser(text);
    const thinkingEl = addThinking();

    try {
      const res = await fetch(WORKER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text, history }),
      });
      const data = await res.json();
      thinkingEl.remove();
      addBot(data.text || 'No response.');
      history.push({ role: 'user', text });
      history.push({ role: 'bot', text: data.text || '' });
    } catch (err) {
      thinkingEl.remove();
      addBot("Couldn't reach the assistant just now — try again in a moment.");
    }
  });
</script>

<style>
  #chat-root {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 100;
    font-family: var(--font-body);
  }
  #chat-launcher {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
    border: none;
    border-radius: 999px;
    padding: 10px 16px 10px 12px;
    font: 500 13px var(--font-body);
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
  }
  .chat-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--status);
    animation: chat-pulse 1.8s ease-in-out infinite;
  }
  @keyframes chat-pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--status) 55%, transparent); }
    50% { box-shadow: 0 0 0 6px transparent; }
  }
  #chat-root.open #chat-launcher { display: none; }

  #chat-panel {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(360px, calc(100vw - 40px));
    height: min(480px, calc(100vh - 100px));
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: chat-in 160ms ease-out;
  }
  #chat-panel[hidden] {
    display: none;
  }
  @keyframes chat-in {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .chat-head {
    position: relative;
    padding: 12px 36px 10px 14px;
    border-bottom: 1px solid var(--border);
  }
  .chat-head-title {
    display: block;
    font: 600 13px var(--font-body);
    color: var(--fg);
  }
  .chat-head-sub {
    display: block;
    font: 11px var(--font-mono);
    color: var(--muted);
    margin-top: 2px;
  }
  #chat-close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 26px;
    height: 26px;
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    border-radius: 6px;
  }
  #chat-close:hover { background: var(--divider); color: var(--fg); }

  #chat-log {
    flex: 1;
    overflow-y: auto;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .msg {
    font-size: 13.5px;
    line-height: 1.55;
    white-space: pre-wrap;
    max-width: 90%;
  }
  .msg.user {
    align-self: flex-end;
    background: var(--accent);
    color: #fff;
    padding: 7px 11px;
    border-radius: 10px 10px 2px 10px;
  }
  .msg.bot {
    align-self: flex-start;
    color: var(--tag-fg);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .msg.thinking .cursor {
    animation: chat-blink 0.9s steps(1) infinite;
    color: var(--accent);
  }
  @keyframes chat-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  #chat-form {
    display: flex;
    gap: 8px;
    padding: 10px;
    border-top: 1px solid var(--border);
  }
  #chat-input {
    flex: 1;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    padding: 8px 10px;
    font: 13px var(--font-body);
    background: var(--bg);
    color: var(--fg);
  }
  #chat-input:focus { outline: none; border-color: var(--accent); }
  #chat-form button[type='submit'] {
    border: none;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
    border-radius: 8px;
    padding: 0 14px;
    font: 500 13px var(--font-body);
    cursor: pointer;
  }

  @media (max-width: 480px) {
    #chat-root { right: 12px; bottom: 12px; }
    .chat-launcher-label { display: none; }
    #chat-launcher { padding: 12px; }
  }
</style>
