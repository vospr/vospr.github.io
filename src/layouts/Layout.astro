---
import { SHOW_CV } from '../config';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'AI Solutions Engineer with twenty years in finance, building agentic AI, RAG and MLOps systems. Based in Neuchâtel, Switzerland.' } = Astro.props;
const pageTitle = `${title} · Andrey Popov`;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://vospr.github.io').toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">Andrey Popov</a>
        <nav class="nav">
          <a href="/ai-solutions">AI</a>
          <a href="/ml-data-science">ML / MLOps</a>
          <a href="/software-engineering">Software</a>
          {SHOW_CV && <a class="cv" href="/cv.pdf">CV ↓</a>}
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap">Andrey Popov — AI Solutions Engineer</div>
    </footer>
    <ChatWidget />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --fg: #15171a; --bg: #fafaf8; --surface: #ffffff; --muted: #5c6066; --tag-fg: #3a3d42;
    --hook-color: #33363b; --accent: #3557e8; --accent-hover: #1f3fc4;
    --border: #e4e4e0; --border-strong: #d8d8d3; --divider: #efefeb; --status: #2e8540;
    --btn-primary-bg: #15171a; --btn-primary-fg: #ffffff; --btn-primary-hover: #33363b;
    --font-heading: 'Source Serif 4', Georgia, serif;
    --font-body: 'IBM Plex Sans', system-ui, sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, monospace;
    --container: 880px; --measure: 680px; --prose: 640px; --gutter: 24px; --radius: 6px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --fg: #ededed; --bg: #0f1012; --surface: #16181b; --muted: #9a9ea4; --tag-fg: #c4c7cb;
      --hook-color: #d4d6d9; --accent: #7b93ff; --accent-hover: #a3b4ff;
      --border: #2a2c30; --border-strong: #34373c; --divider: #222428; --status: #4cc36a;
      --btn-primary-bg: #ededed; --btn-primary-fg: #0f1012; --btn-primary-hover: #d4d6d9;
    }
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.6 var(--font-body); -webkit-font-smoothing: antialiased; min-height: 100dvh; }
  a { color: var(--accent); }
  a:hover { color: var(--accent-hover); }
  .wrap { max-width: var(--container); margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); }
  .site-header { border-bottom: 1px solid var(--border); }
  .site-header .wrap { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 10px 24px; padding-top: 18px; padding-bottom: 18px; }
  .brand { font: 600 18px var(--font-heading); color: var(--fg); text-decoration: none; }
  .nav { display: flex; flex-wrap: wrap; gap: 20px; font-size: 14px; }
  .nav a { color: var(--muted); text-decoration: none; }
  .nav a:hover { color: var(--fg); }
  .nav a.cv { color: var(--accent); font-weight: 500; }
  .label { font: 500 12px/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0 0 10px; }
  .meta { font: 12px var(--font-mono); color: var(--muted); }
  .meta a { color: var(--muted); text-decoration: none; }
  h1 { font: 600 40px/1.12 var(--font-heading); letter-spacing: -.01em; margin: 0; text-wrap: pretty; }
  .home { display: flex; flex-direction: column; gap: 56px; padding-top: 56px; padding-bottom: 64px; }
  .hero { max-width: var(--measure); display: flex; flex-direction: column; gap: 18px; }
  .avail { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; }
  .avail .on { display: inline-flex; align-items: center; gap: 6px; color: var(--fg); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--status); }
  .lede { margin: 0; font-size: 18px; color: var(--hook-color); text-wrap: pretty; }
  .btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .btn { font-size: 14px; padding: 10px 16px; border-radius: var(--radius); text-decoration: none; border: 1px solid var(--border-strong); background: var(--surface); color: var(--fg); }
  .btn:hover { border-color: var(--accent); color: var(--fg); }
  .btn.primary { background: var(--btn-primary-bg); color: var(--btn-primary-fg); border-color: var(--btn-primary-bg); font-weight: 500; }
  .btn.primary:hover { background: var(--btn-primary-hover); color: var(--btn-primary-fg); }
  .btn-icon {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--fg);
    text-decoration: none;
    flex: none;
  }
  .btn-icon:hover { border-color: var(--accent); color: var(--accent); }
  .list-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 6px 28px; padding: 18px 0; border-top: 1px solid var(--border); color: var(--fg); text-decoration: none; }
  .row:hover { color: var(--accent); }
  .row .t { font-weight: 600; font-size: 17px; display: block; }
  .row .sum { font-size: 15px; color: var(--hook-color); display: block; margin-bottom: 8px; text-wrap: pretty; }
  .areas { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; }
  .area { display: flex; justify-content: space-between; gap: 10px; padding: 14px 16px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); color: var(--fg); text-decoration: none; font-weight: 600; }
  .area:hover { border-color: var(--accent); color: var(--fg); }
  .area .meta { font-weight: 400; }
  .divider { border: none; border-top: 4px dashed var(--border); margin: 0; }
  .project { display: flex; flex-direction: column; gap: 36px; padding-top: 48px; padding-bottom: 64px; }
  .intro { max-width: var(--measure); display: flex; flex-direction: column; gap: 14px; }
  .hook { font: 20px/1.5 var(--font-heading); color: var(--hook-color); margin: 0; text-wrap: pretty; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .facts div { padding: 14px 16px; border-right: 1px solid var(--divider); display: flex; flex-direction: column; gap: 2px; }
  .facts div:last-child { border-right: none; }
  .k { font: 11px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .v { font-size: 15px; font-weight: 500; }
  .body { display: flex; flex-wrap: wrap-reverse; gap: 40px; align-items: flex-start; }
  .main { flex: 999 1 420px; max-width: var(--prose); display: flex; flex-direction: column; gap: 32px; }
  .main p { margin: 0; text-wrap: pretty; }
  .main ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; }
  .main li strong { font-weight: 600; }
  .aside { flex: 1 1 220px; display: flex; flex-direction: column; gap: 18px; padding: 18px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .aside .grp { display: flex; flex-direction: column; gap: 6px; }
  .aside .items { font: 13px/1.7 var(--font-mono); color: var(--tag-fg); }
  .aside a { font: 14px var(--font-mono); text-decoration: none; }
  .site-footer { border-top: 1px solid var(--border); }
  .site-footer .wrap { padding-top: 28px; padding-bottom: 28px; font-size: 13px; color: var(--muted); }
</style>
