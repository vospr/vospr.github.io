---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Andrey Popov — AI Solutions Engineer' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Andrey Popov</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Andrey Popov</a>
      <nav>
        <a href="/ai-solutions">AI Solutions</a>
        <a href="/ml-data-science">ML / MLOps + Data Science</a>
        <a href="/software-engineering">Software Engineering</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Andrey Popov — AI Solutions Engineer · Neuchâtel, Switzerland</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --fg: #1a1a1a;
    --bg: #ffffff;
    --muted: #666;
    --accent: #2563eb;
    --border: #e5e5e5;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --fg: #e8e8e8;
      --bg: #121212;
      --muted: #999;
      --border: #2a2a2a;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    color: var(--fg);
    background: var(--bg);
    line-height: 1.55;
  }
  main {
    max-width: 780px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .brand {
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
    font-size: 1.05rem;
  }
  .site-header nav {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .site-header nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .site-header nav a:hover { color: var(--accent); }
  .site-footer {
    text-align: center;
    padding: 2rem 1.25rem;
    color: var(--muted);
    font-size: 0.85rem;
    border-top: 1px solid var(--border);
  }
  h1 { font-size: 1.75rem; margin-bottom: 0.25rem; }
  h2 { font-size: 1.2rem; margin-top: 2rem; }
  .hook {
    color: var(--muted);
    font-style: italic;
    margin-top: 0;
  }
  .card {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.1rem 1.25rem;
    margin-bottom: 1rem;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .card:hover { border-color: var(--accent); }
  .card h3 { margin: 0 0 0.35rem; font-size: 1.05rem; }
  .card p { margin: 0; color: var(--muted); font-size: 0.92rem; }
  .badge {
    display: inline-block;
    font-size: 0.72rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    margin-left: 0.5rem;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.5rem 0 1.5rem;
  }
  .stack span {
    font-size: 0.78rem;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
  }
  .links a {
    color: var(--accent);
    margin-right: 1rem;
  }
</style>
